\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Every DSEC training sequence whose exposure is pinned at 14\,996\,\ensuremath  {\mu }s, measured per labeled box over the events inside that box during that frame's own published exposure window, with at least 400{} events per box. $m$ is the median over boxes of the modulation depth $m=2|C|$ at 100\,Hz. $Z_{100}$ and $Z_{137}$ are the median over boxes of the Rayleigh statistic at 100\,Hz and at the off-frequency control on the same events. The analytic $\mathrm  {Exp}(1)$ median of 0.693{} does not describe either column, which is why the two are compared with each other. The locked fraction denotes the fraction of boxes whose local excess at 100\,Hz exceeds the ninety-ninth percentile of the same quantity at 137\,Hz.}}{5}{table.caption.17}\protected@file@percent }
\newlabel{tab:sixseq}{{2}{5}{Every DSEC training sequence whose exposure is pinned at \dsecExpMax \,\micro s, measured per labeled box over the events inside that box during that frame's own published exposure window, with at least \sixMinEvents {} events per box. $m$ is the median over boxes of the modulation depth $m=2|C|$ at \flickerLineHz \,Hz. $Z_{\flickerLineHz }$ and $Z_{\flickerCtrlHz }$ are the median over boxes of the Rayleigh statistic at \flickerLineHz \,Hz and at the off-frequency control on the same events. The analytic $\mathrm {Exp}(1)$ median of \flickerZnull {} does not describe either column, which is why the two are compared with each other. The locked fraction denotes the fraction of boxes whose local excess at \flickerLineHz \,Hz exceeds the ninety-ninth percentile of the same quantity at \flickerCtrlHz \,Hz}{table.caption.17}{}}
\newlabel{tab:sixseq@cref}{{[table][2][]2}{[1][5][]5}{}{}{}}
