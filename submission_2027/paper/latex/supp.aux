\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Every event inside one published 14\,996\,\ensuremath  {\mu }s exposure window of \texttt  {zurich\_city\_09\_a}, colored by its position within that window, with that frame's released boxes numbered left to right. The frame is the median-dispersion one of 602{} eligible candidate frames with at least six qualifying boxes, not the largest.}}{5}{figure.caption.16}\protected@file@percent }
\newlabel{fig:qualitative}{{3}{5}{Every event inside one published \dsecExpMax \,\micro s exposure window of \texttt {zurich\_city\_09\_a}, colored by its position within that window, with that frame's released boxes numbered left to right. The frame is the median-dispersion one of \figFiveCands {} eligible candidate frames with at least six qualifying boxes, not the largest}{figure.caption.16}{}}
